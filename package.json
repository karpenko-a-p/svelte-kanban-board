{
  "name": "sveltekit-template",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev --host",
    "build": "bunx --bun vite build",
    "compile": "bun build --compile --target=bun --minify ./build/index.js --outfile my-svelte-app",
    "preview": "bunx --bun vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "imports": {
    "#view/*": "./src/view/*",
    "#app/*": "./src/app/*",
    "#routes/*": "./src/routes/*",
    "#project/*": "./*",
    "#src/*": "./src/*",
    "#svelte-kit/*": "./.svelte-kit/types/src/routes/*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.0",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/sveltekit": "10.5.10",
    "@sveltejs/adapter-bun": "1.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "autoprefixer": "10.5.4",
    "baseline-browser-mapping": "2.11.20",
    "cssnano": "9.0.1",
    "dbmate": "2.35.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-storybook": "10.5.10",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "happy-dom": "20.12.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "storybook": "10.5.10",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@tabler/icons-svelte": "3.44.0",
    "dayjs": "1.11.23",
    "jose": "6.2.9",
    "pino": "10.3.1",
    "pino-roll": "4.0.0"
  },
  "browserslist": [
    "last 15 versions",
    "not dead",
    "> 0.2%"
  ]
}
