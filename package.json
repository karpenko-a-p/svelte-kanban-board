{
  "name": "sveltekit-template",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun --smol vite dev --host",
    "build": "bunx --bun vite build",
    "compile": "bun build --compile --target=bun --minify ./build/index.js --outfile my-svelte-app",
    "preview": "bunx --bun --smol vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.2.1",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/sveltekit": "10.4.6",
    "@sveltejs/kit": "2.66.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/postcss": "4.3.1",
    "@tailwindcss/vite": "4.3.1",
    "@types/bun": "1.3.14",
    "autoprefixer": "10.5.0",
    "baseline-browser-mapping": "2.10.38",
    "cssnano": "8.0.2",
    "dbmate": "2.35.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-storybook": "10.4.6",
    "eslint-plugin-svelte": "3.19.0",
    "globals": "17.6.0",
    "happy-dom": "20.11.2",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.4",
    "prettier-plugin-svelte": "4.1.1",
    "storybook": "10.4.6",
    "svelte": "5.56.3",
    "svelte-adapter-bun": "1.0.1",
    "svelte-check": "4.6.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@tabler/icons-svelte": "3.44.0",
    "dayjs": "1.11.23",
    "jose": "6.2.9",
    "pino": "10.3.1",
    "pino-roll": "4.0.0"
  },
  "browserslist": [
    "last 15 versions",
    "not dead",
    "> 0.2%"
  ]
}
